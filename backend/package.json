    "express": "^4.19.0",
    "node-cron": "^3.0.3",
    "winston": "^3.13.0",
    "compression": "^1.7.4",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/compression": "^1.7.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
